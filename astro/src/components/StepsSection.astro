---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["steps"];
}

const { data } = Astro.props;
---

<section class="section section--dark" aria-labelledby={data.titleId}>
  <div class="section__header">
    <span class="section__eyebrow">{data.eyebrow}</span>
    <h2 id={data.titleId}>{data.title}</h2>
    <p>{data.text}</p>
  </div>

  <ol class="steps">
    {
      data.items.map((item) => (
        <li>
          <span>{item.number}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))
    }
  </ol>
</section>
