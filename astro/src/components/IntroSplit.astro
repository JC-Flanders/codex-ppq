---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["intro"];
}

const { data } = Astro.props;
---

<section class="section section--intro" aria-labelledby="what-title">
  <div class="section__eyebrow">{data.eyebrow}</div>
  <div class="split">
    <div>
      <h2 id="what-title">{data.title}</h2>
      <p>{data.text}</p>
    </div>
    <div class="feature-list" aria-label={data.ariaLabel}>
      {
        data.features.map((feature) => (
          <div>
            <span>{feature.title}</span>
            <p>{feature.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
