---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["results"];
}

const { data } = Astro.props;
---

<section class="section" id="example" aria-labelledby="results-title">
  <div class="section__header">
    <span class="section__eyebrow">{data.eyebrow}</span>
    <h2 id="results-title">{data.title}</h2>
    <p>{data.text}</p>
  </div>

  <div class="data-showcase">
    {
      data.metrics.map((metric) => (
        <article class:list={["metric-card", { "metric-card--large": metric.large }]}>
          <span>{metric.label}</span>
          <strong>{metric.value}</strong>
          <p>{metric.text}</p>
        </article>
      ))
    }
  </div>
</section>
