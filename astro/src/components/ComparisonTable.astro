---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["comparison"];
}

const { data } = Astro.props;
---

<section class="section" aria-labelledby="comparison-title">
  <div class="section__header">
    <span class="section__eyebrow">{data.eyebrow}</span>
    <h2 id="comparison-title">{data.title}</h2>
  </div>
  <div class="comparison-card" role="region" aria-label={data.ariaLabel}>
    <table>
      <thead>
        <tr>
          <th>Category</th>
          <th>{data.leftHeader}</th>
          <th>{data.rightHeader}</th>
        </tr>
      </thead>
      <tbody>
        {
          data.rows.map((row) => (
            <tr>
              <th>{row.category}</th>
              <td data-label={data.leftHeader}>{row.left}</td>
              <td data-label={data.rightHeader}>{row.right}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
