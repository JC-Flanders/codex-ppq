---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["prompt"];
}

const { data } = Astro.props;
---

<section class="section section--prompt" id="prompt" aria-labelledby="prompt-title">
  <div class="prompt-layout">
    <div>
      <span class="section__eyebrow">{data.eyebrow}</span>
      <h2 id="prompt-title">{data.title}</h2>
      <p>{data.text}</p>
      <button class="copy-button" type="button" data-copy-target={data.copyTarget}>
        {data.buttonLabel}
        <span aria-hidden="true">&rarr;</span>
      </button>
    </div>
    <pre class="code-block" id={data.copyTarget}><code>{data.code}</code></pre>
  </div>
</section>
