---
import type { UseCaseFrontmatter } from "../types";

interface Props {
  data: UseCaseFrontmatter["facts"];
}

const { data } = Astro.props;
---

<section class="section" id="endpoint" aria-labelledby="endpoint-title">
  <div class="endpoint-layout">
    <div>
      <span class="section__eyebrow">{data.eyebrow}</span>
      <h2 id="endpoint-title">{data.title}</h2>
      <p>{data.text}</p>
    </div>
    <div class="facts-panel" aria-label={data.ariaLabel}>
      <dl>
        {
          data.items.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
